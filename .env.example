# ==============================================================================
# Variables de Entorno del Sistema de Conciliación y Sincronización de Stock
# ==============================================================================

# Cadena de conexión a base de datos PostgreSQL (versión 15+ con extensión pg_trgm habilitada)
DATABASE_URL=postgresql://usuario:password@localhost:5432/catalogo_db

# ------------------------------------------------------------------------------
# Motor de Inferencia Laya (Sistema 1 - ModernBERT)
# ------------------------------------------------------------------------------
# URL del servicio de inferencia Laya (por defecto el backend FastAPI local en el puerto 8000)
LAYA_API_URL=http://localhost:8000

# Identificador del modelo de inferencia semántica Laya
LAYA_MODEL_ID=convaiinnovations/laya

# Checkpoint/subfolder del modelo (recomendado 'multilingual' para catálogos en español)
LAYA_SUBFOLDER=multilingual

# Clave de API para el servicio de inferencia (opcional si LAYA_API_URL es local; obligatoria para endpoints remotos o Vercel AI Gateway)
AI_GATEWAY_API_KEY=local-dev-key

# Identificador retrocompatible para el modelo previo
JEV_MODEL_ID=convaiinnovations/laya

# ------------------------------------------------------------------------------
# Parámetros Operacionales del Worker
# ------------------------------------------------------------------------------
# Tamaño de lote para el procesamiento por chunks del worker
BATCH_SIZE=50

# Concurrencia máxima para llamadas paralelas al servicio de inferencia
MAX_CONCURRENCY=5

# Umbral léxico mínimo para el operador de trigramas en PostgreSQL (rango 0.0 - 1.0)
PG_TRGM_THRESHOLD=0.60

# Umbral para auto-confirmación determinista de coincidencias (CONFIRMED)
CONFIRMED_MATCH_THRESHOLD=0.90

# Umbral para envío a revisión manual (REQUIRES_REVIEW). Debe ser menor a CONFIRMED_MATCH_THRESHOLD
REVIEW_MATCH_THRESHOLD=0.70

# Entorno de ejecución
NODE_ENV=development
