# ==============================================================================
# Variables de Entorno del Sistema de Conciliación y Sincronización de Stock
# ==============================================================================

# Cadena de conexión a base de datos PostgreSQL (versión 15+ con extensión pg_trgm habilitada)
DATABASE_URL=postgresql://usuario:password@localhost:5432/catalogo_db

# Clave de API de Vercel AI Gateway para el servicio de inferencia
AI_GATEWAY_API_KEY=tu_api_key_de_ai_gateway_aqui

# Identificador del modelo de inferencia semántica JEV
JEV_MODEL_ID=typesafe-ai/jev

# Tamaño de lote para el procesamiento por chunks del worker
BATCH_SIZE=50

# Concurrencia máxima para llamadas paralelas al servicio de inferencia
MAX_CONCURRENCY=5

# Umbral léxico mínimo para el operador de trigramas en PostgreSQL (rango 0.0 - 1.0)
PG_TRGM_THRESHOLD=0.60

# Umbral para auto-confirmación determinista de coincidencias (CONFIRMED)
CONFIRMED_MATCH_THRESHOLD=0.90

# Umbral para envío a revisión manual (REQUIRES_REVIEW). Debe ser menor a CONFIRMED_MATCH_THRESHOLD
REVIEW_MATCH_THRESHOLD=0.70

# Entorno de ejecución
NODE_ENV=development
